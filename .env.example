# Google Gemini API Key (100% Free Tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Read-only repo & contents access)
GITHUB_ACCESS_TOKEN=your_github_token_here

# Meta WhatsApp Cloud API (Optional Sandbox integration)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here
MY_PHONE_NUMBER=your_verified_whatsapp_phone_number_here

# Environment & Storage Config
ENV=development
DATABASE_PATH=watchdog.db
STACK_CONTEXT_PATH=stack_context.json
PORT=8000
